{
  "name": "twibbonify",
  "version": "1.0.0",
  "private": false,
  "description": "Buat twibbon massal langsung di browser — 100% client-side.",
  "type": "module",
  "keywords": [
    "twibbon",
    "photo-frame",
    "client-side",
    "pwa",
    "browser"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fadhil-Sabar/twibbonify.git"
  },
  "bugs": {
    "url": "https://github.com/Fadhil-Sabar/twibbonify/issues"
  },
  "homepage": "https://github.com/Fadhil-Sabar/twibbonify#readme",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "lint": "eslint .",
    "preview": "bun run build && wrangler dev",
    "deploy": "bun run build && wrangler deploy"
  },
  "dependencies": {
    "@tanstack/react-router": "latest",
    "dexie": "latest",
    "fflate": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "sonner": "latest",
    "zod": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "latest",
    "eslint-plugin-react-refresh": "latest",
    "globals": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "latest",
    "vite": "latest",
    "vite-plugin-pwa": "latest",
    "vitest": "latest",
    "wrangler": "^4.112.0"
  }
}
